# Copy to .env.local and fill with your Supabase project values
# (Supabase dashboard -> Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public URL of the app (used in e-mail links). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown in the privacy policy and terms (LGPD: who answers for the data and how to reach them)
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# Apoia-se page (https://...). Empty: /apoiar says there is nowhere to give yet and the links to it stay hidden
NEXT_PUBLIC_SUPPORT_URL=
# "1" shows "Entrar com Google" (only after enabling Google in Supabase; see README)
NEXT_PUBLIC_GOOGLE_LOGIN=
# Error reports (Sentry). Empty = off. Set only in Vercel Production. The DSN is public by design (it only sends events).
NEXT_PUBLIC_SENTRY_DSN=

# --- Optional: AI review of photos (Gemini). Without these the feature is off. ---
# Server-only secrets: never prefix with NEXT_PUBLIC_.
# Google AI Studio -> Get API key
GEMINI_API_KEY=
# Model id shown in AI Studio (default: gemini-flash-latest)
GEMINI_MODEL=
# Lighter model tried when the main one is overloaded/slow (default: gemini-flash-lite-latest)
GEMINI_FALLBACK_MODEL=
# Supabase -> Project Settings -> API Keys -> secret / service_role
SUPABASE_SERVICE_ROLE_KEY=

# Server-only random secret for the scheduled reminder/weekly endpoints.
# Without it, cron requests are rejected. Never reuse the local E2E fixture in production.
CRON_SECRET=

# --- Optional: Sentry source maps (readable stack traces). Server/build-only secret: Production only. ---
# Without the token the build skips the upload and reports still work, with minified stacks.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
